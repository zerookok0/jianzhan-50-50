# ============================================================================
# LOCAL SECRETS — never committed, never deployed
# ----------------------------------------------------------------------------
# .gitignore excludes this file (verified by scripts/verify-build.mjs).
# These values are for `wrangler dev` on your machine only.
#
# ENVIRONMENT must stay "development". It is what enables the test payment
# gateway (worker/routes/mock-gateway.ts) and what stops the mock provider
# from being constructed anywhere else.
# ============================================================================

ENVIRONMENT="development"

# Signs the session/CSRF material. Local only — generate a real one for prod:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="local-dev-only-session-secret-not-for-production"

# Signs the webhooks the test gateway emits. Because the mock gateway SIGNS
# its events and the real webhook handler VERIFIES them, the full security
# path is exercised locally — this is not a bypass.
PAYMENT_MOCK_SECRET="local-mock-secret-do-not-use-in-production"

# One-time token for creating the first admin account. Unused until you call
# POST /api/v1/admin/bootstrap, and should be deleted immediately afterwards.
ADMIN_BOOTSTRAP_TOKEN="local-bootstrap-token"
